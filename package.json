{
  "name": "agenda-views-monorepo",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "pnpm --filter agenda-views build && pnpm --filter demo build",
    "build:lib": "pnpm --filter agenda-views build",
    "dev": "pnpm --filter demo dev",
    "test": "pnpm --filter agenda-views test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "validate": "pnpm --filter agenda-views validate"
  }
}
